<Window x:Class="JueguitoLenguajes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JueguitoLenguajes"
        xmlns:vm="clr-namespace:JueguitoLenguajes.ViewModel"
        xmlns:conv="clr-namespace:JueguitoLenguajes.Converters"
        mc:Ignorable="d"
        Title="Tic Tac Toe" Height="727" Width="800">

    <Window.DataContext>
        <vm:TicTacToe/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="EstiloCelda" TargetType="Button">
            <Setter Property="Background" Value="#3D1066"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="FontSize" Value="42"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="110"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                BorderThickness="2"
                                BorderBrush="#5A1A8A">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#521480"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF8C00"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#661A99"/>
                            </Trigger>

                            <Trigger Property="Content" Value="X">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                             Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             From="0"
                                             To="1"
                                             Duration="0:0:0.20"/>
                                            <DoubleAnimation
                                             Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             From="0"
                                             To="1"
                                             Duration="0:0:0.20"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Setter Property="Foreground" Value="#FF9F1C"/>
                            </Trigger>

                            <Trigger Property="Content" Value="O">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                             Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             From="0"
                                             To="1"
                                             Duration="0:0:0.20"/>
                                            <DoubleAnimation
                                             Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             From="0"
                                             To="1"
                                             Duration="0:0:0.20"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Setter Property="Foreground" Value="#4ADE80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EstiloBoton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                             CornerRadius="14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF8C00" Offset="0"/>
                                    <GradientStop Color="#FF6000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12"
                                               ShadowDepth="4"
                                               Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                             Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1.05"
                                             Duration="0:0:0.15"/>
                                            <DoubleAnimation
                                             Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1.05"
                                             Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                             Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1"
                                             Duration="0:0:0.15"/>
                                            <DoubleAnimation
                                             Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1"
                                             Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border"
                                     Property="Opacity"
                                     Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EstiloBotonSecundario" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#4ADE80" Offset="0"/>
                                    <GradientStop Color="#22C55E" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EstiloTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#3D1066"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#5A1A8A"/>
            <Setter Property="CaretBrush" Value="#FF8C00"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EstiloPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#3D1066"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#5A1A8A"/>
            <Setter Property="CaretBrush" Value="#FF8C00"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6A0DAD" Offset="0"/>
            <GradientStop Color="#4B0082" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <!-- Login Jugador 1 -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="28" Padding="40" Width="450"
                Visibility="{Binding MostrarLoginJ1, Converter={StaticResource BoolToVisibility}}">
            <Border.Background>
                <SolidColorBrush Color="#2D0A50"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="50"
                                  ShadowDepth="10" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="tic.tac.toe" FontFamily="Segoe UI Black" FontSize="48"
                           Foreground="#FF8C00" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock Text="JUGADOR 1 (X)" FontSize="24" FontWeight="Bold"
                           Foreground="#FF8C00" HorizontalAlignment="Center" Margin="0,0,0,30"
                           FontFamily="Segoe UI Black"/>

                <TextBlock Text="Usuario" FontSize="14" Foreground="#E0B0FF" Margin="0,0,0,8"/>
                <TextBox Text="{Binding NombreJ1, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource EstiloTextBox}" Margin="0,0,0,20"/>

                <TextBlock Text="Contraseña" FontSize="14" Foreground="#E0B0FF" Margin="0,0,0,8"/>
                <PasswordBox x:Name="PwdJ1Box" 
                             Style="{StaticResource EstiloPasswordBox}" Margin="0,0,0,30"
                             PasswordChanged="PwdJ1Box_PasswordChanged"/>

<Button Content="INICIAR SESIÓN"
                         Style="{StaticResource EstiloBoton}"
                         Command="{Binding IniciarSesionJ1Command}"/>

                <TextBlock Text="o" FontSize="16" Foreground="#E0B0FF" 
                           HorizontalAlignment="Center" Margin="0,20,0,15"/>

                <Button Content="CREAR CUENTA"
                         Style="{StaticResource EstiloBotonSecundario}"
                         Command="{Binding MostrarRegistroCommand}"/>
            </StackPanel>
        </Border>

        <!-- Registro de Cuenta -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="28" Padding="40" Width="450"
                Visibility="{Binding MostrarRegistro, Converter={StaticResource BoolToVisibility}}">
            <Border.Background>
                <SolidColorBrush Color="#2D0A50"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="50"
                                  ShadowDepth="10" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="tic.tac.toe" FontFamily="Segoe UI Black" FontSize="48"
                           Foreground="#FF8C00" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock Text="CREAR CUENTA" FontSize="24" FontWeight="Bold"
                           Foreground="#FF8C00" HorizontalAlignment="Center" Margin="0,0,0,30"
                           FontFamily="Segoe UI Black"/>

                <TextBlock Text="Usuario" FontSize="14" Foreground="#E0B0FF" Margin="0,0,0,8"/>
                <TextBox Text="{Binding NombreRegistro, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource EstiloTextBox}" Margin="0,0,0,20"/>

                <TextBlock Text="Contraseña" FontSize="14" Foreground="#E0B0FF" Margin="0,0,0,8"/>
                <PasswordBox x:Name="PwdRegistroBox"
                             Style="{StaticResource EstiloPasswordBox}" Margin="0,0,0,20"
                             PasswordChanged="PwdRegistroBox_PasswordChanged"/>

                <Button Content="REGISTRAR"
                        Style="{StaticResource EstiloBoton}"
                        Command="{Binding RegistrarCommand}" Margin="0,0,0,15"/>

                <Button Content="VOLVER"
                        Style="{StaticResource EstiloBotonSecundario}"
                        Command="{Binding VolverLoginCommand}"/>
            </StackPanel>
        </Border>

        <!-- Login Jugador 2 -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="28" Padding="40" Width="450"
                Visibility="{Binding MostrarLoginJ2, Converter={StaticResource BoolToVisibility}}">
            <Border.Background>
                <SolidColorBrush Color="#2D0A50"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="50"
                                  ShadowDepth="10" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="tic.tac.toe" FontFamily="Segoe UI Black" FontSize="48"
                           Foreground="#4ADE80" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock Text="JUGADOR 2 (O)" FontSize="24" FontWeight="Bold"
                           Foreground="#4ADE80" HorizontalAlignment="Center" Margin="0,0,0,30"
                           FontFamily="Segoe UI Black"/>

                <TextBlock Text="Usuario" FontSize="14" Foreground="#E0B0FF" Margin="0,0,0,8"/>
                <TextBox Text="{Binding NombreJ2, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource EstiloTextBox}" Margin="0,0,0,20"/>

                <TextBlock Text="Contraseña" FontSize="14" Foreground="#E0B0FF" Margin="0,0,0,8"/>
                <PasswordBox x:Name="PwdJ2Box"
                             Style="{StaticResource EstiloPasswordBox}" Margin="0,0,0,20"
                             PasswordChanged="PwdJ2Box_PasswordChanged"/>

                <Button Content="INICIAR SESIÓN"
                        Style="{StaticResource EstiloBoton}" Margin="0,0,0,15"
                        Command="{Binding IniciarSesionJ2Command}"/>

                <TextBlock Text="o" FontSize="16" Foreground="#E0B0FF" 
                           HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <Button Content="🤖 JUGAR CONTRA EL BOT"
                        Style="{StaticResource EstiloBotonSecundario}"
                        Command="{Binding IniciarSesionBotCommand}" Margin="0,0,0,15"/>

                <Button Content="VOLVER"
                        Style="{StaticResource EstiloBotonSecundario}"
                        Command="{Binding VolverALoginJ1Command}"/>
            </StackPanel>
        </Border>

        <!-- Pantalla de Juego -->
        <Grid Visibility="{Binding MostrarJuego, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left"
                        Margin="30,0,0,30" Opacity="0.85">
                <TextBlock Text="tic." FontFamily="Segoe UI Black" FontSize="68"
                           Foreground="#FF8C00" LineHeight="60"/>
                <TextBlock Text="tac." FontFamily="Segoe UI Black" FontSize="68"
                           Foreground="#4ADE80" LineHeight="60"/>
                <TextBlock Text="toe." FontFamily="Segoe UI Black" FontSize="68"
                           Foreground="#FF8C00" LineHeight="60"/>
            </StackPanel>

            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="28" Padding="36,30" Width="442">
                <Border.Background>
                    <SolidColorBrush Color="#2D0A50"/>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="50"
                                      ShadowDepth="10" Opacity="0.6"/>
                </Border.Effect>

                <StackPanel>
                    <Grid Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Jugador X - Naranja -->
                        <Border Grid.Column="0" CornerRadius="14" Padding="16,10"
                                Width="110" Margin="0,0,6,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF8C00" Offset="0"/>
                                    <GradientStop Color="#E07000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="JUGADOR X" FontSize="10" FontWeight="Bold"
                                           Foreground="#3A1A00" HorizontalAlignment="Center"
                                           FontFamily="Segoe UI Black" Opacity="0.85"/>
                                <TextBlock Text="{Binding VictoriasJ1}" FontSize="32" FontWeight="Bold"
                                           Foreground="#1A0800" HorizontalAlignment="Center"
                                           FontFamily="Segoe UI Black"/>
                            </StackPanel>
                        </Border>

                        <!-- Empate -->
                        <Border Grid.Column="1" CornerRadius="14" Padding="16,10"
                                Width="110" Margin="3,0" Background="#3D1066">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="EMPATE" FontSize="10" FontWeight="Bold"
                                           Foreground="#E0B0FF" HorizontalAlignment="Center"
                                           FontFamily="Segoe UI Black" Opacity="0.85"/>
                                <TextBlock Text="{Binding Empates}" FontSize="32" FontWeight="Bold"
                                           Foreground="#F5F0FF" HorizontalAlignment="Center"
                                           FontFamily="Segoe UI Black"/>
                            </StackPanel>
                        </Border>

                        <!-- Jugador O - verde -->
                        <Border Grid.Column="2" CornerRadius="14" Padding="16,10"
                                Width="110" Margin="6,0,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4ADE80" Offset="0"/>
                                    <GradientStop Color="#22C55E" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="JUGADOR O" FontSize="10" FontWeight="Bold"
                                           Foreground="#0A2E18" HorizontalAlignment="Center"
                                           FontFamily="Segoe UI Black" Opacity="0.80"/>
                                <TextBlock Text="{Binding VictoriasJ2}" FontSize="32" FontWeight="Bold"
                                           Foreground="#061A0E" HorizontalAlignment="Center"
                                           FontFamily="Segoe UI Black"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding MensajeTurno}"
                               FontFamily="Segoe UI Semibold"
                               FontSize="14"
                               Foreground="{Binding ColorTurno}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>

                    <Grid HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="{Binding Celda00}" Foreground="{Binding ColorCelda00}" Grid.Row="0" Grid.Column="0" Style="{StaticResource EstiloCelda}" Command="{Binding MarcarCasillaCommand}" CommandParameter="0,0"/>
                        <Button Content="{Binding Celda01}" Foreground="{Binding ColorCelda01}" Grid.Row="0" Grid.Column="1" Style="{StaticResource EstiloCelda}" Command="{Binding MarcarCasillaCommand}" CommandParameter="0,1"/>
                        <Button Content="{Binding Celda02}" Foreground="{Binding ColorCelda02}" Grid.Row="0" Grid.Column="2" Style="{StaticResource EstiloCelda}" Command="{Binding MarcarCasillaCommand}" CommandParameter="0,2"/>

                        <Button Content="{Binding Celda10}" Foreground="{Binding ColorCelda10}" Grid.Row="1" Grid.Column="0" Style="{StaticResource EstiloCelda}" Command="{Binding MarcarCasillaCommand}" CommandParameter="1,0"/>
                        <Button Content="{Binding Celda11}" Foreground="{Binding ColorCelda11}" Grid.Row="1" Grid.Column="1" Style="{StaticResource EstiloCelda}" Command="{Binding MarcarCasillaCommand}" CommandParameter="1,1"/>
                        <Button Content="{Binding Celda12}" Foreground="{Binding ColorCelda12}" Grid.Row="1" Grid.Column="2" Style="{StaticResource EstiloCelda}" Command="{Binding MarcarCasillaCommand}" CommandParameter="1,2"/>

                        <Button Content="{Binding Celda20}" Foreground="{Binding ColorCelda20}" Grid.Row="2" Grid.Column="0" Style="{StaticResource EstiloCelda}" Command="{Binding MarcarCasillaCommand}" CommandParameter="2,0"/>
                        <Button Content="{Binding Celda21}" Foreground="{Binding ColorCelda21}" Grid.Row="2" Grid.Column="1" Style="{StaticResource EstiloCelda}" Command="{Binding MarcarCasillaCommand}" CommandParameter="2,1"/>
                        <Button Content="{Binding Celda22}" Foreground="{Binding ColorCelda22}" Grid.Row="2" Grid.Column="2" Style="{StaticResource EstiloCelda}" Command="{Binding MarcarCasillaCommand}" CommandParameter="2,2"/>
                    </Grid>

                    <Button Content="Nuevo Juego"
                            Style="{StaticResource EstiloBoton}"
                            Command="{Binding ReiniciarJuegoCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
